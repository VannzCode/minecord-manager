# Discord application settings
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id
GUILD_ID=your_test_server_id

# Minecraft Java Edition server
MINECRAFT_HOST=play.example.com
MINECRAFT_PORT=25565
MINECRAFT_TIMEOUT_MS=5000

# Optional: announcements and maintenance updates go to this channel.
# Leave blank to send in the channel where the command was used.
ANNOUNCEMENT_CHANNEL_ID=

# Optional comma-separated Discord role IDs allowed to run admin commands.
# Discord's Manage Server permission is also required.
ADMIN_ROLE_IDS=

# Optional bot activity text
BOT_ACTIVITY_TEXT=Watching your Minecraft server
